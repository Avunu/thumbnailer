{
  "name": "@avunu/thumbnailer",
  "version": "1.1.1",
  "description": "Client-side thumbnail generation for PDF, PostScript, TIFF and common image formats, using Ghostscript-WASM and OffscreenCanvas in a Web Worker.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/thumbnailer.umd.js",
  "module": "./dist/thumbnailer.js",
  "types": "./dist/thumbnailer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/thumbnailer.d.ts",
      "import": "./dist/thumbnailer.js",
      "require": "./dist/thumbnailer.umd.js"
    },
    "./worker": "./dist/worker.js",
    "./gs.wasm": "./dist/gs.wasm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avunu/thumbnailer.git"
  },
  "homepage": "https://github.com/Avunu/thumbnailer",
  "bugs": {
    "url": "https://github.com/Avunu/thumbnailer/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && rolldown -c rolldown.config.ts",
    "build:demo": "BUILD_DEMO=1 rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:typecheck": "oxlint --type-aware -c .oxlintrc.typecheck.json .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "versions": "node scripts/check-versions.mjs",
    "check": "npm run format:check && npm run lint && npm run lint:typecheck && npm run typecheck && npm run versions",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:playground": "node tests/playground/run.mjs",
    "prepublishOnly": "npm run build",
    "upgrade": "npx npm-check-updates -u && npm install"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@privyid/ghostscript": "0.1.0-alpha.1",
    "@types/node": "^26.4.1",
    "exifreader": "^4.44.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "^1.2.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
