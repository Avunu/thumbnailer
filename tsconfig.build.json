{
	/* Emits the .d.ts tree for the published npm package — package.json's
     "types" field points at the dist/thumbnailer.d.ts this produces. Runtime
     JavaScript comes from rollup; this pass emits declarations only. */
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["src/php", "third-party", "node_modules", "dist"]
}
