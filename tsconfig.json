{
	"compilerOptions": {
		/* ES2022 rather than ES2020. The real browser floor is set by the two
		   features the library cannot work without — module Web Workers and
		   OffscreenCanvas.convertToBlob — which land in Chrome 80/76, Firefox
		   114/105 and Safari 15/16.4. Every one of those already ships the
		   whole of ES2022, so nothing is gained by targeting lower. */
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"skipLibCheck": true,
		"types": [],

		/* Bundler mode */
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		/* allowJs stays off deliberately. With it on, tsc follows the
       third-party/utif/UTIF.js import into the Nix store and tries to emit
       declarations next to it, which fails EACCES. The untyped import is
       fenced off with @ts-expect-error in worker.ts instead. */
		"allowJs": false,

		/* This program is typecheck-only. Declarations for the published package
       are emitted by tsconfig.build.json. Rolldown transpiles TypeScript but
       never typechecks it, so `tsc` is the only thing standing between a type
       error and a shipped build — which is why the build script runs it. */
		"noEmit": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "demo/*.ts", "tests/unit/**/*.ts"],
	"exclude": ["node_modules", "dist", "third-party"]
}
