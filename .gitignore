# Build output. The demo bundle is generated by `npm run build:demo`; it used to
# be committed, which made every `npm run build` dirty the working tree.
/dist
/demo/demo.js
/demo/demo.js.map

# Dependencies
/node_modules
# Composer's vendor tree; the plugin zip carries it, git does not.
/vendor
# UTIF.js, symlinked in from the `utif` flake input by both the Nix
# derivation's postPatch and the dev shell's shellHook. Never committed —
# flake.lock is the single pin. See flake.nix.
/third-party

# Nix / direnv
/result
/result-*
.direnv
# Generated by git-hooks.nix and symlinked into the Nix store by the dev shell.
/.pre-commit-config.yaml

# Test artifacts
/.phpunit.cache
/test-results
/playwright-report
/blob-report
/tests/playground/node_modules

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.sw?

# Logs
*.log
