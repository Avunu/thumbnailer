{
    "name": "avunu/thumbnailer",
    "description": "Makes the Thumbnailer client-side thumbnail library available on selected WordPress posts and pages.",
    "type": "wordpress-plugin",
    "version": "1.1.0",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.1",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.8",
        "phpunit/phpunit": "^12",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "replace": {
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "Avunu\\Thumbnailer\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Avunu\\Thumbnailer\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "check": [
            "@phpstan",
            "@test"
        ]
    }
}
